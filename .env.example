# The only required value.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# GUARD_MODEL=claude-haiku-5-5
# ROUTER_MODEL=claude-haiku-5-5
# SUPERVISOR_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-opus-5-5
# EXECUTOR_PRESET=sonnet        # sonnet | haiku | hybrid
# EXECUTOR_MODEL=               # forces one executor model for every route
# EXECUTOR_EFFORT=low
# EXECUTOR_FALLBACKS=default    # server-side refusal fallback on Sonnet 5.5; "off" to disable
# BOOKLY_DB=./bookly.db
