# The only required value.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# GUARD_MODEL=claude-haiku-5-5
# ROUTER_MODEL=claude-haiku-5-5
# SUPERVISOR_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-opus-5-5
# EXECUTOR_PRESET=sonnet        # sonnet | haiku | hybrid
# EXECUTOR_MODEL=               # forces one executor model for every route
# EXECUTOR_EFFORT=low
# EXECUTOR_FALLBACKS=default    # server-side refusal fallback on Sonnet 5.5; "off" to disable
# BOOKLY_DB=./bookly.db

# Voice (optional): set to show the mic in the web UI. Speech-to-text and text-to-speech use ElevenLabs.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George"; any id from your ElevenLabs Voice Library
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1
